include README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include src *.py
recursive-include tests *.py
recursive-include examples *.py
recursive-include examples *.html
include examples/maze_previews/quantum_walk/walk.json
include examples/maze_previews/glued_trees/glued_trees.json
recursive-include benchmarks *.py *.md *.json *.csv *.txt *.svg
recursive-include scripts *.py *.sh
recursive-include scripts *.cjs
recursive-include docs *.md *.svg *.png
recursive-include notebooks *.md *.ipynb
recursive-include .github *.yml *.yaml
prune .release-artifacts
global-exclude *.py[cod]
global-exclude .DS_Store
prune build
prune dist
prune .venv
prune .ipynb_checkpoints

include examples/data/sentence_pairs.csv
